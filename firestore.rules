rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // OTP codes — only Cloud Functions (admin SDK) can read/write these.
    // Clients have NO direct access whatsoever.
    match /otpCodes/{uid} {
      allow read, write: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
